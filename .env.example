# m12 server config. Keep this file private (it's in .gitignore).
M12_USER=zki
# generate with: npm run hash-password
M12_PASSWORD_HASH=

# Bind to loopback and put a TLS reverse proxy (Caddy/nginx) in front.
HOST=127.0.0.1
PORT=8080
# Proxy on the same box sets X-Forwarded-For; only honoured when HOST is loopback.
TRUST_PROXY=1
# Your public URL, used for the CSRF origin check, e.g. https://m12.example.com
# PUBLIC_ORIGIN=
# Alternatively serve TLS directly (then HOST may be 0.0.0.0):
# TLS_CERT_FILE=/etc/letsencrypt/live/m12.example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/m12.example.com/privkey.pem

# Fleet size shown in the dashboard (1..1000).
M12_NODE_COUNT=1000

# --- mTLS telemetry ingest (nodes report here) ---
# Generate the PKI first:  ./scripts/pki.sh init-ca && ./scripts/pki.sh server-cert <public-host>
# then issue a cert per node:  ./scripts/pki.sh node-cert node-mips-0007
# Leave these unset to disable the ingest listener (dashboard shows demo data).
INGEST_HOST=0.0.0.0
INGEST_PORT=8443
#INGEST_CA_FILE=./pki/ca.crt
#INGEST_CERT_FILE=./pki/server.crt
#INGEST_KEY_FILE=./pki/server.key
#INGEST_REVOKED_FILE=./pki/revoked.txt
# A node is shown offline if it hasn't checked in within this many minutes.
NODE_OFFLINE_AFTER_MIN=10

# --- Build endpoint (compiles the MIPS agent from the dashboard) ---
# Off unless set to 1. Only the logged-in admin, same-origin, can trigger it.
M12_BUILD_ENABLED=0
# Cross-compiler prefix passed to `make CROSS=...` (validated; no shell).
M12_BUILD_CROSS=mips-linux-gnu-
# Where the built binary is published (e.g. your TFTP root).
M12_BUILD_DEST=/srv/tftp/m12-agent
# Optional extra secret required as the X-M12-Build-Token header.
#M12_BUILD_TOKEN=
M12_BUILD_TIMEOUT_SEC=600

# --- Remote diagnostics: run commands on nodes ---
# DANGER: remote code execution on your fleet. Off unless set to 1.
M12_EXEC_ENABLED=0
# Optional allowlist of exact commands (comma-separated). Empty = any command.
#M12_EXEC_ALLOWLIST=uptime,uname -a,df -h,cat /proc/loadavg
