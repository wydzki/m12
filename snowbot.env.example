# m12 production env for the VPS (snowbot). Copy to .env, fill in the hash, done.
#
#   cp snowbot.env.example .env
#   M12_USER is set below; create the password hash on the box:
#   npm run hash-password      # paste the printed line over M12_PASSWORD_HASH
#   chmod 600 .env
#
# NOTE: ./v pins the listening ports (UI 8801, ingest 8802) and overrides any
# PORT/INGEST_PORT set here, so they're intentionally omitted.

M12_USER=zki
# Replace with the line from `npm run hash-password` (run it on snowbot, not here):
M12_PASSWORD_HASH=

# --- UI / API ---
# Loopback only. Reach it via Caddy (https) or an SSH tunnel — never serve the
# login page over plain http on a public IP (the server refuses that anyway).
HOST=127.0.0.1
# The proxy on this box (Caddy) sets X-Forwarded-For; honoured only on loopback.
TRUST_PROXY=1

# Serving via Caddy at a real domain? Set this to lock the CSRF origin check to it:
PUBLIC_ORIGIN=https://c.zki.lol
#
# Reaching the UI through an SSH tunnel to http://localhost:8801 instead?
# Then comment out PUBLIC_ORIGIN above and uncomment the next line (loopback http):
#COOKIE_SECURE=0

# Demo fleet size shown until real nodes report in over mTLS.
# Show a sample fleet until real nodes report. Set to 0 for a clean/empty dashboard.
M12_DEMO=0
M12_NODE_COUNT=50
NODE_OFFLINE_AFTER_MIN=10

# --- Remote diagnostics: run commands on nodes ---
# DANGER: remote code execution on your fleet (root on most embedded Linux).
# Leave OFF unless you use it; prefer the allowlist over wide-open shell.
M12_EXEC_ENABLED=0
#M12_EXEC_ALLOWLIST=uptime,uname -a,df -h,cat /proc/loadavg

# --- mTLS telemetry ingest (port 8802, set by ./v) ---
# Bind to all interfaces; mTLS makes that safe. Generate the PKI first:
#   ./scripts/pki.sh init-ca && ./scripts/pki.sh server-cert c.zki.lol
# then UNCOMMENT these so 8802 starts listening (the server won't boot if these
# point at files that don't exist yet, so leave them commented until then):
INGEST_HOST=0.0.0.0
#INGEST_CA_FILE=./pki/ca.crt
#INGEST_CERT_FILE=./pki/server.crt
#INGEST_KEY_FILE=./pki/server.key
#INGEST_REVOKED_FILE=./pki/revoked.txt

# --- Build endpoint (compile the MIPS agent from the dashboard) ---
# Leave OFF unless you use it; it runs a compiler on request.
M12_BUILD_ENABLED=0
M12_BUILD_CROSS=mips-linux-gnu-
M12_BUILD_DEST=/srv/tftp/m12-agent
#M12_BUILD_TOKEN=
M12_BUILD_TIMEOUT_SEC=600
